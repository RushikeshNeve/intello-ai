# =============================================================================
# Universal Knowledge OS — local environment contract (M00.01.02)
# =============================================================================
# Copy to the repository root as `.env` (git-ignored) and replace every
# `change-me-*` placeholder before first start:
#
#     cp infrastructure/env/.env.example .env
#
# Rules
#   * Every value below is a SAFE PLACEHOLDER. Never commit real secrets.
#   * Host ports use the UKOS block (web 3300, api 8300, rushdb 3310, objects 9300,
#     postgres 5532, redis 6479, oidc 8380; LM Studio on the host uses 1234) so other local projects that
#     use 3000/5432/6379/8000 never collide. All bind to 127.0.0.1 only. Nothing is
#     exposed on the LAN by default.
#   * Variable names are a shared contract consumed by infrastructure/compose/*.yml,
#     apps/api and apps/web. Renaming one requires coordinator approval
#     (docs/execution/DECISION_CHANGES.md).
#   * $0 recurring cost: no variable here points at a paid or mandatory cloud API.
# =============================================================================

# --- Global ------------------------------------------------------------------
# Docker Compose project name; isolated test runs override this (e.g. ukos-test-<id>).
COMPOSE_PROJECT_NAME=ukos
# local | test | ci
UKOS_ENV=local
# Interface every published host port binds to. Keep 127.0.0.1 for local-first safety.
UKOS_BIND_HOST=127.0.0.1
# debug | info | warning | error
UKOS_LOG_LEVEL=info

# --- PostgreSQL (authoritative operational DB; ADR-013) ----------------------
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_HOST_PORT=5532
POSTGRES_DB=ukos
# Superuser used only for bootstrap/migrations. The API must not run as this role (RLS bypass risk).
POSTGRES_USER=ukos_admin
POSTGRES_PASSWORD=change-me-postgres-admin
# Least-privilege application role (LOGIN, NOSUPERUSER, NOBYPASSRLS) created on first start by
# infrastructure/compose/postgres/init/10-app-role.sh. Migrations (M01+) own table grants and RLS policies.
POSTGRES_APP_USER=ukos_app
POSTGRES_APP_PASSWORD=change-me-postgres-app
# Connection string used by the API from inside the compose network (SQLAlchemy-style scheme;
# the API normalizes `postgresql+psycopg://` for psycopg).
DATABASE_URL=postgresql+psycopg://ukos_app:change-me-postgres-app@postgres:5432/ukos
# Migration connection (admin role) used by Alembic from inside the compose network.
DATABASE_MIGRATION_URL=postgresql+psycopg://ukos_admin:change-me-postgres-admin@postgres:5432/ukos

# --- Redis (Celery broker only; NOT durable truth — ADR-036) ------------------
REDIS_IMAGE=redis:7.4-alpine
REDIS_HOST_PORT=6479
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-redis@redis:6379/1

# --- RushDB 3 (knowledge index; ADR-012 — CONDITIONAL GO, docs/spikes/rushdb-validation.md) -
# Pinned exact release (digest sha256:95cc9ce5…b7358). Re-run tests/spikes/rushdb_*.py before any upgrade.
RUSHDB_IMAGE=rushdb/rushdb:3.0.10
# Host port for the RushDB HTTP protocol (container port 3000). 3310 is inside the UKOS port block.
# The node runs with --multitenant, which is PERMANENT for a data volume: a volume created in
# single-tenant mode can never be opened multitenant (and vice versa).
RUSHDB_HTTP_HOST_PORT=3310
# Operator token. It is valid for EVERY tenant (the tenant is chosen by the X-RushDB-Tenant header),
# so only the API and workers that strictly need it may hold it. Never sent to the browser.
RUSHDB_TOKEN=change-me-rushdb-token
# URL the API uses inside the compose network.
RUSHDB_URL=http://rushdb:3000
# URL used from the host (tests, scripts).
RUSHDB_HTTP_URL=http://127.0.0.1:3310

# --- Object storage (S3-compatible; ADR-007/051) ------------------------------
# Provider chosen in M00.02.03 (docs/spikes/object-storage.md): RustFS 1.0.5 (Apache-2.0),
# fallback chrislusf/seaweedfs:4.53. Re-run tests/spikes/objectstore_contract.py before any upgrade.
OBJECT_STORE_IMAGE=rustfs/rustfs:1.0.5
# One-shot bucket/CORS bootstrap (plain S3 calls only, idempotent).
OBJECT_STORE_INIT_IMAGE=amazon/aws-cli:2.40.3
OBJECT_STORE_LOG_LEVEL=warn
# Provider-neutral names: the API depends only on the S3 API, never on a vendor SDK feature.
OBJECT_STORE_HOST_PORT=9300
# Endpoint used inside the compose network.
S3_ENDPOINT_URL=http://objectstore:9000
# Endpoint used for presigned URLs handed to the browser (must be reachable from the host).
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9300
# Local providers accept us-east-1; Cloudflare R2 uses `auto`.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key
S3_BUCKET_ORIGINALS=ukos-originals
S3_BUCKET_ARTIFACTS=ukos-artifacts
S3_FORCE_PATH_STYLE=true
# Lifetime of presigned read/upload URLs, seconds.
S3_PRESIGN_TTL_SECONDS=300

# --- API (FastAPI modular monolith; ADR-034) ---------------------------------
API_HOST_PORT=8300
# Origins allowed by CORS; comma-separated.
API_CORS_ORIGINS=http://127.0.0.1:3300,http://localhost:3300
# Server-side secret for signing app-level tokens/cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-api-secret-key

# --- Web (Next.js App Router; ADR-042) ---------------------------------------
WEB_HOST_PORT=3300
# Base URL the browser uses to call the API.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8300
# Base URL the Next.js server uses to call the API inside the compose network.
API_INTERNAL_BASE_URL=http://api:8000
# Public origin of the web app (OIDC redirect, CSRF origin check, Secure-cookie decision).
WEB_PUBLIC_URL=http://127.0.0.1:3300
# Seals the session cookie (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=change-me-web-session-secret-at-least-32-chars

# --- Identity (local OIDC: Dex; ADR-026, DC-012) -----------------------------
# Pinned to v2.45.1: v2.46.0/v2.46.1 hang on every refresh_token grant and then stop serving (DC-016).
OIDC_IMAGE=ghcr.io/dexidp/dex:v2.45.1
OIDC_HOST_PORT=8380
# Public issuer: what browsers use and what every token's `iss` claim contains.
OIDC_ISSUER_URL=http://127.0.0.1:8380/dex
# Issuer base reachable from inside the compose network (JWKS, token exchange). Same Dex, other URL.
OIDC_INTERNAL_URL=http://dex:5556/dex
# Confidential client used by the Next.js server (BFF). The browser never receives tokens.
OIDC_CLIENT_ID=ukos-web
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
# Comma-separated redirect URIs Dex accepts for ukos-web (override for isolated test stacks).
OIDC_REDIRECT_URIS=http://127.0.0.1:3300/api/auth/callback,http://localhost:3300/api/auth/callback
# The API's audience: tokens must contain this in `aud` (Dex cross-client trust from ukos-web).
OIDC_AUDIENCE=ukos-api
OIDC_API_CLIENT_SECRET=change-me-oidc-api-client-secret
# ID-token lifetime (Go duration). Short-lived; the web session refreshes server-side.
OIDC_ID_TOKEN_TTL=15m
OIDC_LOG_LEVEL=info

# --- Local AI inference (ADR-020/022; DC-011; benchmarked in M00.03.04) -----
# Local by default via LM Studio running natively on the HOST (not a container), serving an
# OpenAI-compatible API on 127.0.0.1:1234. The gateway speaks only the /v1 API, so Ollama,
# llama.cpp `llama-server` or vLLM are drop-in alternatives. No paid provider key is needed.
# NOTE: LM Studio's terms allow personal/internal use only, so a hosted SaaS deployment must use
# a different /v1 backend (docs/spikes/local-models.md).
AI_PROVIDER=lmstudio
# Base URL used from inside containers (api/workers); apps.yml maps host.docker.internal.
AI_BASE_URL=http://host.docker.internal:1234/v1
# Base URL used from the host (tests, scripts).
AI_HOST_BASE_URL=http://127.0.0.1:1234/v1
# Defaults chosen in docs/spikes/local-models.md. Changing the embedding model or dimensions
# creates a NEW embedding space and requires re-embedding (ADR-020). Query/document prefixes
# belong to the embedding adapter's model registry, not to this file.
AI_EMBEDDING_MODEL=google/embedding-gemma-300m
AI_EMBEDDING_DIMENSIONS=768
AI_CHAT_MODEL=google/gemma-3-4b
# Optional external providers stay disabled unless a tenant policy allows them (ADR-030).
AI_EXTERNAL_PROVIDERS_ENABLED=false
