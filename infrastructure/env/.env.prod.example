# =============================================================================
# Intello AI (UKOS) — PRODUCTION environment for the single-VM stack (M10 preparation, UNTESTED on a VM)
# =============================================================================
# Copy to the repository root as `.env.prod` (git-ignored, chmod 600) and replace EVERY `CHANGE_ME*` value:
#     cp infrastructure/env/.env.prod.example .env.prod && chmod 600 .env.prod
# Then:  bash scripts/deploy/preflight.sh      (validates this file, prints no secret values)
#
# Legend:  [SECRET] never commit/share/log   [PUBLIC] safe to show   [GEN] generate with the command shown
# Rules: generated secrets below are hex or base64url (no `$`, quotes, `#`, spaces), so they are safe in this file.
# Values like ${NAME} are expanded by docker compose (dotenv interpolation); do not quote them.
# =============================================================================

# --- Identity of the deployment ------------------------------------------------
COMPOSE_PROJECT_NAME=ukos-prod
UKOS_ENV=production
UKOS_BIND_HOST=127.0.0.1
UKOS_LOG_LEVEL=info
# Set by scripts/deploy/deploy.sh (git short sha); leave as is.
UKOS_IMAGE_TAG=local

# --- Public URLs and TLS [PUBLIC] -----------------------------------------------
# Hostnames that DNS points to the VM (A record). Two hosts: the app, and the object store
# (presigned upload/download URLs need their own host). Examples: app.example.org / files.example.org.
PUBLIC_HOST=CHANGE_ME_app.example.org
FILES_HOST=CHANGE_ME_files.example.org
# Must equal https://${PUBLIC_HOST} (preflight checks). Drives cookies (Secure, __Host- prefix), CORS and OIDC.
PUBLIC_BASE_URL=https://CHANGE_ME_app.example.org
# Contact for Let's Encrypt expiry notices.
ACME_EMAIL=CHANGE_ME@example.org

# --- Web / OIDC [mixed] ----------------------------------------------------------
WEB_PUBLIC_URL=${PUBLIC_BASE_URL}
NEXT_PUBLIC_API_BASE_URL=${PUBLIC_BASE_URL}
API_CORS_ORIGINS=${PUBLIC_BASE_URL}
# Issuer is public https; containers reach the SAME https URL through Caddy's network alias (see prod.yml).
OIDC_ISSUER_URL=${PUBLIC_BASE_URL}/dex
OIDC_INTERNAL_URL=${PUBLIC_BASE_URL}/dex
OIDC_CLIENT_ID=ukos-web
OIDC_AUDIENCE=ukos-api
OIDC_REDIRECT_URIS=${PUBLIC_BASE_URL}/api/auth/callback
# [SECRET][GEN] openssl rand -hex 32
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
# [SECRET][GEN] openssl rand -hex 32
OIDC_API_CLIENT_SECRET=CHANGE_ME_OIDC_API_CLIENT_SECRET
# [SECRET][GEN] openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'     (>= 32 chars; also keys the Redis session encryption)
WEB_SESSION_SECRET=CHANGE_ME_WEB_SESSION_SECRET
# [SECRET][GEN] openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
API_SECRET_KEY=CHANGE_ME_API_SECRET_KEY

# --- Dex bootstrap admin (the first human sign-in; no test users exist in production) -----
DEX_ADMIN_EMAIL=CHANGE_ME_admin@example.org
# [GEN] cat /proc/sys/kernel/random/uuid
DEX_ADMIN_USER_ID=CHANGE_ME_UUID
# [SECRET][GEN] bcrypt hash of the admin password, base64 (one line). Choose a long password, then:
#   docker run --rm httpd:2-alpine htpasswd -nbBC 10 "" 'YOUR-LONG-PASSWORD' | cut -d: -f2 | tr -d '\n' | base64 -w0
DEX_ADMIN_PASSWORD_HASH_B64=CHANGE_ME_DEX_ADMIN_PASSWORD_HASH_B64

# --- PostgreSQL ---------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=ukos
POSTGRES_USER=ukos_admin
POSTGRES_APP_USER=ukos_app
POSTGRES_WORKER_USER=ukos_worker
# [SECRET][GEN] each:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP_PASSWORD
POSTGRES_WORKER_PASSWORD=CHANGE_ME_POSTGRES_WORKER_PASSWORD
# [SECRET via the passwords above] connection strings are assembled, do not edit.
DATABASE_URL=postgresql+psycopg://${POSTGRES_APP_USER}:${POSTGRES_APP_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_MIGRATION_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_WORKER_URL=postgresql+psycopg://${POSTGRES_WORKER_USER}:${POSTGRES_WORKER_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Redis (Celery broker, web sessions) --------------------------------------------
REDIS_IMAGE=redis:7.4-alpine
# [SECRET][GEN] openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
# Database 2 holds the web session store (encrypted records).
WEB_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/2

# --- RushDB (knowledge index). Multitenant mode is PERMANENT for the data volume. ----------
RUSHDB_IMAGE=rushdb/rushdb:3.0.10
RUSHDB_URL=http://rushdb:3000
RUSHDB_HTTP_HOST_PORT=3310
RUSHDB_HTTP_URL=http://127.0.0.1:3310
# [SECRET][GEN] openssl rand -hex 32     (valid for EVERY tenant: only api/workers hold it)
RUSHDB_TOKEN=CHANGE_ME_RUSHDB_TOKEN

# --- Object store (RustFS on the VM; swap to R2/B2 by changing these, config only) ----------
OBJECT_STORE_IMAGE=rustfs/rustfs:1.0.5
OBJECT_STORE_INIT_IMAGE=amazon/aws-cli:2.40.3
S3_ENDPOINT_URL=http://objectstore:9000
# Browser-facing endpoint for presigned URLs: https://${FILES_HOST}
S3_PUBLIC_ENDPOINT_URL=https://${FILES_HOST}
S3_REGION=us-east-1
S3_BUCKET_ORIGINALS=ukos-originals
S3_BUCKET_ARTIFACTS=ukos-artifacts
S3_FORCE_PATH_STYLE=true
# [SECRET][GEN] openssl rand -hex 16   and   openssl rand -hex 32
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY

# --- AI provider (OpenAI-compatible; default hosted). Local LM Studio is NOT assumed. ----------
# NEW embedding space (1536 dims) versus dev (768): a fresh index, no mixing. Never change the model/dimensions
# of a populated deployment without the re-embed procedure.
AI_BASE_URL=https://api.openai.com/v1
# [SECRET] key of the provider account (from the provider's console; NOT generated here).
AI_API_KEY=CHANGE_ME_AI_API_KEY
AI_EXTERNAL_PROVIDERS_ENABLED=true
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Hosted embedding models take no prefixes (empty on purpose).
AI_EMBEDDING_QUERY_PREFIX=
AI_EMBEDDING_DOCUMENT_PREFIX=
AI_EMBEDDING_SPEC_VERSION=1
CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Connectors (optional; leave empty to disable GitHub/URL-token connectors) ------------------
# [SECRET][GEN] openssl rand -base64 32      (standard base64 of 32 random bytes, as connectors/crypto.py decodes it)
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_ENCRYPTION_KEY_ID=k1

# --- Backups (scripts/deploy/backup-cron.sh) ----------------------------------------------------
# Newest N local backups kept.
BACKUP_KEEP=7
BACKUP_DIR=/var/backups/ukos
# Optional off-VM copy, an rclone destination such as  remote:ukos-backups  (empty = local only).
# Configure the remote once with `rclone config` as the deploying user. Credentials live in rclone's own config.
BACKUP_RCLONE_REMOTE=
